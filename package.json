{
  "name": "blog-informatica-unlp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm check:terms && pnpm check:lines && pnpm test:hooks",
    "check:terms": "node scripts/check-forbidden-terms.mjs --all",
    "check:lines": "node scripts/check-file-lines.mjs --all",
    "labels:sync": "node scripts/github/sync-labels.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:hooks": "node --test \".claude/hooks/tests/*.test.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "postcss": "^8.5.33",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "minimatch": ">=10.2.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "lefthook": "^2.2.3",
    "playwright": "^1.65.1",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  }
}
